# datus-agent 源码目录（用于 build context）
# 默认为 nocodb 同级目录下的 datus-agent-ob/datus-agent
# 若目录结构不同，请修改为绝对路径，例如：
# DATUS_SOURCE_PATH=/Users/zihaoxu/Desktop/datus-agent-ob/datus-agent
DATUS_SOURCE_PATH=../../../datus-agent-ob/datus-agent

# 使用 sudo 启动时，$HOME 会变成 /root，导致挂载错目录。在此设置实际用户的 home 路径
# DATUS_HOME=/home/xzh495328

# Datus OAuth 认证（与 datus 服务端 agent.yml 中的 client 配置一致）
# NC_DATUS_CLIENT_ID=datus_client
# NC_DATUS_CLIENT_SECRET=datus_secret_key

# HuggingFace 镜像（可选，国内加速）
# HF_ENDPOINT=https://hf-mirror.com
