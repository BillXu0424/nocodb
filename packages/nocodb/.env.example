# 复制为 .env 后按需修改。后端启动时会自动加载 .env（Noco.ts 中 dotenv.config()）。

# ---------- PostgreSQL：每 Base 一个 schema ----------
# NC_DB=pg://localhost:5432?u=postgres&p=password&d=postgres

# ---------- SQLite + 每 Base 独立 SQLite 文件（NC_MINIMAL_DBS）----------
# 元数据库（存 nc_* 等）和 per-base 库都会放在 NC_TOOL_DIR 下
NC_DB=sqlite3://?d=noco.db
NC_MINIMAL_DBS=true

# 可选
# NC_PORT=8080
# NC_DISABLE_TELE=true
